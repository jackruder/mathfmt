% packages the notation's commands need and the preamble does not load
\usepackage{unicode-math-input}
% Unicode math input: each character means what the profile spells it as (unicode-math-input's own table lacks some and reads others differently)
\umiDeclareMathChar{Σ}{\Sigma}
\umiDeclareMathChar{θ}{\theta}
\umiDeclareMathChar{μ}{\mu}
\umiDeclareMathChar{ℝ}{\mathbb{R}}
\umiDeclareMathChar{→}{\rightarrow}
\umiDeclareMathChar{∈}{\in}
\umiDeclareMathChar{∞}{\infty}
\umiDeclareMathChar{≤}{\leq}
\umiDeclareMathChar{⊤}{\top}
\umiDeclareMathChar{𝐖}{\mathbf{W}}
\umiDeclareMathChar{𝐱}{\mathbf{x}}
\umiDeclareMathChar{𝒩}{\mathcal{N}}
\umiDeclareMathChar{𝔼}{\mathbb{E}}
\umiDeclareMathChar{𝝈}{\boldsymbol{\sigma}}
\umiDeclareMathChar{𝟙}{\mathbbm{1}}
